<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>Veil.App</AssemblyName>
    <RootNamespace>Veil.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon />
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\installer\payload.manifest.json" Link="payload.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Veil.Engine\Veil.Engine.csproj" />
    <ProjectReference Include="..\Veil.Recovery\Veil.Recovery.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Veil.DriverHelper\Veil.DriverHelper.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <Target Name="CopyCompanionExes" AfterTargets="Build">
    <ItemGroup>
      <_Companion Include="$(MSBuildThisFileDirectory)..\Veil.Recovery\bin\$(Configuration)\Veil.Recovery.exe" />
      <_Companion Include="$(MSBuildThisFileDirectory)..\Veil.Recovery\bin\$(Configuration)\Veil.Recovery.dll" />
      <_Companion Include="$(MSBuildThisFileDirectory)..\Veil.DriverHelper\bin\$(Configuration)\Veil.DriverHelper.exe" />
      <_Companion Include="$(MSBuildThisFileDirectory)..\Veil.DriverHelper\bin\$(Configuration)\Veil.DriverHelper.dll" />
      <_Companion Include="$(MSBuildThisFileDirectory)..\Veil.DriverHelper\bin\$(Configuration)\Veil.DriverHelper.deps.json" />
      <_Companion Include="$(MSBuildThisFileDirectory)..\Veil.Recovery\bin\$(Configuration)\Veil.Recovery.deps.json" />
      <_Companion Include="$(MSBuildThisFileDirectory)..\Veil.Recovery\bin\$(Configuration)\Veil.Recovery.runtimeconfig.json" />
      <_Companion Include="$(MSBuildThisFileDirectory)..\Veil.DriverHelper\bin\$(Configuration)\Veil.DriverHelper.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_Companion)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(_Companion.Identity)')" />
  </Target>
</Project>
