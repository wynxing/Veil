<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>VeilSetup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <DefineConstants>PackageMsi=$(MSBuildThisFileDirectory)..\Veil.Setup\bin\$(Configuration)\Veil.msi;HelperExe=$(MSBuildThisFileDirectory)..\out\app\Veil.DriverHelper.exe;IconFile=$(MSBuildThisFileDirectory)..\..\assets\icon\veil.ico;LogoFile=$(MSBuildThisFileDirectory)..\..\assets\icon\veil.png;ProductVersion=$(ProductVersion)</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <ProjectReference Include="..\Veil.Setup\Veil.Setup.wixproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>
</Project>
