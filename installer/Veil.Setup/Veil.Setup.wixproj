<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>Veil</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <DefineConstants>PublishDir=$(MSBuildThisFileDirectory)..\out\app;PayloadDir=$(MSBuildThisFileDirectory)..\payload;ProductVersion=$(ProductVersion)</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Package.wxs" />
    <Compile Include="Files.wxs" />
  </ItemGroup>
  <Target Name="RequirePayload" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_VeilPwsh Condition="Exists('$(ProgramFiles)\PowerShell\7\pwsh.exe')">$(ProgramFiles)\PowerShell\7\pwsh.exe</_VeilPwsh>
      <_VeilPwsh Condition="'$(_VeilPwsh)' == ''">$(WINDIR)\System32\WindowsPowerShell\v1.0\powershell.exe</_VeilPwsh>
    </PropertyGroup>
    <Exec Command="&quot;$(_VeilPwsh)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\ValidatePayload.ps1&quot;" />
  </Target>
</Project>
