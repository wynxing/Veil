<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>VeilSetup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>PackageMsi=$(MSBuildThisFileDirectory)bin\$(Configuration)\Veil.msi</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
    <ProjectReference Include="Veil.Setup.wixproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Bundle.wxs" />
    <Compile Remove="Package.wxs;Files.wxs" />
  </ItemGroup>
</Project>
