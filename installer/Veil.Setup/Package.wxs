<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef ProductVersion?>
    <?define ProductVersion="0.1.0"?>
  <?endif?>
  <Package Name="Veil" Manufacturer="Veil" Version="$(var.ProductVersion)" UpgradeCode="9e2c1a0b-4d7e-4c3a-9b11-7f0d2a91e001" Language="1033" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 Veil。" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="VeilIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="VeilIcon.ico" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Veil">
        <Directory Id="VDDDIR" Name="vdd" />
        <Directory Id="NEFCONDIR" Name="nefcon">
          <Directory Id="NEFCONX64" Name="x64" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="VeilMenuDir" Name="Veil" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Property Id="INSTALLVDD" Value="1" />
    <Property Id="CREATEDESKTOPSHORTCUT" Value="0" />
    <Feature Id="App" Title="Veil 应用" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="VddFiles" />
    </Feature>

    <!-- Embedded helper remains available to rollback/commit after RemoveFiles. -->
    <Binary Id="MaintenanceHelper" SourceFile="$(var.PublishDir)\Veil.DriverHelper.exe" />
    <CustomAction Id="BeginMaintenance" BinaryRef="MaintenanceHelper" ExeCommand="begin-maintenance"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ValidateInstallPath" BinaryRef="MaintenanceHelper" ExeCommand='validate-install-path "[INSTALLDIR]Veil.App.exe"'
                  Execute="immediate" Return="check" />
    <CustomAction Id="RollbackMaintenance" BinaryRef="MaintenanceHelper" ExeCommand="end-maintenance"
                  Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="CommitMaintenance" BinaryRef="MaintenanceHelper" ExeCommand="end-maintenance"
                  Execute="commit" Impersonate="no" Return="check" />
    <CustomAction Id="SweepHistoricalSessions" BinaryRef="MaintenanceHelper" ExeCommand="sweep-sessions"
                  Execute="immediate" Impersonate="yes" Return="ignore" />
    <CustomAction Id="RestoreDisplays" BinaryRef="MaintenanceHelper" ExeCommand='restore-displays "[#VeilAppExe]"'
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackVdd" FileRef="VeilDriverHelperExe" ExeCommand="uninstall-driver"
                  Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="InstallVdd" FileRef="VeilDriverHelperExe" ExeCommand="install-driver"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="UninstallVdd" FileRef="VeilDriverHelperExe" ExeCommand="uninstall-driver"
                  Execute="deferred" Impersonate="no" Return="check" />

    <InstallExecuteSequence>
      <Custom Action="ValidateInstallPath" Before="InstallInitialize" Condition="NOT Installed" />
      <Custom Action="SweepHistoricalSessions" Before="RemoveExistingProducts" Condition="WIX_UPGRADE_DETECTED" />
      <Custom Action="RollbackMaintenance" After="InstallInitialize" />
      <Custom Action="BeginMaintenance" After="RollbackMaintenance" />
      <Custom Action="RestoreDisplays" After="BeginMaintenance" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="UninstallVdd" After="RestoreDisplays" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="CommitMaintenance" After="UninstallVdd" />
      <Custom Action="RollbackVdd" After="InstallFiles" Condition="NOT Installed AND INSTALLVDD=1" />
      <Custom Action="InstallVdd" After="RollbackVdd" Condition="NOT Installed AND INSTALLVDD=1" />
    </InstallExecuteSequence>
  </Package>
</Wix>
