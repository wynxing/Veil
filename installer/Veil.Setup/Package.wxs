<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef ProductVersion?>
    <?define ProductVersion="0.1.0"?>
  <?endif?>
  <Package Name="Veil" Manufacturer="Veil" Version="$(var.ProductVersion)" UpgradeCode="9e2c1a0b-4d7e-4c3a-9b11-7f0d2a91e001" Language="1033" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 Veil。" />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Veil">
        <Directory Id="VDDDIR" Name="vdd" />
        <Directory Id="NEFCONDIR" Name="nefcon">
          <Directory Id="NEFCONX64" Name="x64" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Property Id="INSTALLVDD" Value="1" />
    <Feature Id="App" Title="Veil 应用" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
    <Feature Id="BundledVdd" Title="自带虚拟显示驱动" Description="这是显示驱动，用于没有外接屏时关掉笔记本屏幕。默认安装为禁用设备。" Level="1">
      <Level Value="0" Condition="INSTALLVDD=0" />
      <ComponentGroupRef Id="VddFiles" />
    </Feature>

    <CustomAction Id="RestoreDisplays" FileRef="VeilAppExe" ExeCommand="--restore-and-exit"
                  Execute="immediate" Impersonate="yes" Return="ignore" />
    <CustomAction Id="InstallVdd" FileRef="VeilDriverHelperExe" ExeCommand="install-driver"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="UninstallVdd" FileRef="VeilDriverHelperExe" ExeCommand="uninstall-driver"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RestoreDisplays" Before="InstallValidate" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UninstallVdd" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="InstallVdd" After="InstallFiles" Condition="NOT Installed AND INSTALLVDD=1" />
    </InstallExecuteSequence>
  </Package>
</Wix>
